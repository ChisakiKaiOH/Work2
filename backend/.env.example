# Porta del server API
PORT=4000

# Intervallo (in minuti) di raccolta automatica delle metriche
POLL_INTERVAL_MINUTES=60

# --- Credenziali API per i vari social (opzionali) ---
# Se non impostate, l'account usera' l'adapter "demo" con dati simulati.

# X / Twitter API v2 (https://developer.twitter.com)
TWITTER_BEARER_TOKEN=

# Instagram Graph API (richiede account Business/Creator collegato a una Pagina Facebook)
INSTAGRAM_ACCESS_TOKEN=

# YouTube Data API v3 (https://console.cloud.google.com)
YOUTUBE_API_KEY=

# Facebook Graph API
FACEBOOK_ACCESS_TOKEN=

# TikTok non offre una API pubblica di sola lettura per metriche account:
# l'adapter TikTok resta in modalita' demo finche' non si integra un provider terzo.
